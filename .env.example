# Path to the Slay the Spire 2 install (the folder that contains data_sts2_windows_x86_64).
# Windows paths such as C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2 are accepted.
STS2_INSTALL_DIR=

# Optional. Folder that contains BaseLib.dll.
# Leave empty to search:
#   $STS2_INSTALL_DIR/mods/BaseLib/BaseLib.dll
#   $STS2_INSTALL_DIR/mods/BaseLib.dll
# Point this at a GitHub release extract or the Workshop download if the DLL lives elsewhere.
BASELIB_DIR=
