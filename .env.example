# Path to the Slay the Spire 2 install (the folder that contains data_sts2_windows_x86_64).
# Windows paths such as C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2 are accepted.
STS2_INSTALL_DIR=

# Optional. Folder that contains RitsuLib.References.props.
# Leave empty to search:
#   $STS2_INSTALL_DIR/mods/STS2-RitsuLib/
#   $STS2_INSTALL_DIR/mods/RitsuLib/
#   the Steam Workshop download for item 3747602295
# Point this at a GitHub extract or the Workshop download if the bundle lives elsewhere.
RITSULIB_DIR=

# Optional. To compile against a newer game API, pass -p:RitsuLibReferenceTarget=0.111.0 or 0.113.0.
# The default is 0.107.1, which matches this fork's min_game_version.
